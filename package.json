{
  "name": "my-cosmic-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser clock-learning game with two playrooms (Space and Sweet). Working title.",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:assets && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --project=chrome",
    "check:assets": "node tools/check-assets.ts",
    "assets:placeholders": "node tools/gen-placeholders.ts",
    "assets:gen": "node tools/gen-assets.ts",
    "assets:post": "node tools/post-assets.ts",
    "assets:heroine": "node tools/gen-heroine.ts",
    "assets:sounds": "node tools/gen-sounds.ts",
    "assets:thumbs": "node tools/gen-thumbs.ts",
    "measure": "node tools/measure-load.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
